DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
PORT=3001
ALLOWED_IPS=127.0.0.1,::1

# Allowed CORS origins (comma-separated, no trailing slashes)
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Supabase credentials
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Participant/Mentor backend — used to forward SSE broadcast notifications
# so that the mentor portal updates in real-time when admin changes teams.
# Set this to the public URL of your mentor backend in production.
PM_BACKEND_URL=http://localhost:3003

# Shared secret for /api/internal/broadcast-pair-team-update on the mentor backend.
# Set the same value in participant_mentor/backend/.env as INTERNAL_BROADCAST_SECRET.
# INTERNAL_BROADCAST_SECRET=change-me-to-a-random-secret

# ─── Admin account credentials (used by create-admin.js) ────────────────────
# Keep these only in .env — never commit real values
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_admin_password
ADMIN_NAME=Admin Manager
