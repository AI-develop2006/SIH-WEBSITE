DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
PORT=3003

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3003

# Supabase credentials
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Supabase service-role key — NEVER expose in frontend
# Get from: Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Shared secret for /api/internal/broadcast-pair-team-update
# Set the same value in admin/backend/.env
# INTERNAL_BROADCAST_SECRET=change-me-to-a-random-secret

# ─── Admin account credentials (used by create-admin.js) ────────────────────
# Keep these only in .env — never commit real values
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_admin_password
ADMIN_NAME=Admin Manager

# ─── Mentor shared password (used by update-mentor-passwords.js) ─────────────
# Keep this only in .env — never commit real values
MENTOR_PASSWORD=your_mentor_shared_password

# ─── SPOC Portal Credentials (used by create-spoc-user.js) ──────────────────
SPOC_EMAIL=your_spoc_email@example.com
SPOC_PASSWORD=your_spoc_password
SPOC_NAME=SPOC Name
