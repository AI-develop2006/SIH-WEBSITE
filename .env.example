DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
PORT=3004

# Allowed CORS origins (comma-separated, no trailing slashes)
ALLOWED_ORIGINS=https://your-spoc-frontend.vercel.app

# Supabase credentials
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# ─── SPOC account credentials (used by create-spoc-user.js) ─────────────────
# Keep these only in .env — never commit real values
SPOC_EMAIL=your_spoc_email@example.com
SPOC_PASSWORD=your_spoc_password
SPOC_NAME=SPOC Name
