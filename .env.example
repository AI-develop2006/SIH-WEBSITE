# SPOC Frontend — Environment Variables
# Copy to .env and fill in values

# SPOC backend (handles auth, final teams, spoc events)
VITE_BACKEND_URL=http://localhost:3004

# Mentor/participant backend — used to subscribe to pair-team SSE events
# so that ministry/skill changes made in the mentor portal are reflected here
VITE_PM_BACKEND_URL=http://localhost:3003

# Production: set these in Vercel/Netlify dashboard
# VITE_BACKEND_URL=https://your-spoc-render-backend.onrender.com
# VITE_PM_BACKEND_URL=https://your-pm-render-backend.onrender.com
